'use strict';
/* JSON-хранилище для локальной работы и тестов (один процесс, атомарная запись в файл). */
const fs = require('fs');
const path = require('path');

const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, '..', 'data');
const DB_FILE = path.join(DATA_DIR, 'db.json');

const EMPTY = {
  users: [],        // профили
  codes: [],        // одноразовые коды (хранится только хеш)
  sessions: [],     // сессии (хранится только хеш токена)
  orders: [],       // заказы
  messages: [],     // чат по заказам
  notifications: [],// уведомления
  positions: [],    // последняя геопозиция перевозчика по заказу
  geoCache: {},     // кеш геокодирования адресов
  meta: { version: 1 }
};

let db = null;
let saveChain = Promise.resolve();

function ensureDir() {
  if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });
}

function load() {
  if (db) return db;
  ensureDir();
  try {
    if (fs.existsSync(DB_FILE)) {
      db = Object.assign({}, EMPTY, JSON.parse(fs.readFileSync(DB_FILE, 'utf8')));
      for (const k of Object.keys(EMPTY)) if (db[k] == null) db[k] = EMPTY[k];
      return db;
    }
  } catch (err) {
    console.error('[store] не удалось прочитать db.json, начинаю с пустой базы:', err.message);
  }
  db = JSON.parse(JSON.stringify(EMPTY));
  saveSync();
  return db;
}

function saveSync() {
  ensureDir();
  const tmp = DB_FILE + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(db, null, 2), 'utf8');
  fs.renameSync(tmp, DB_FILE);
}

/* атомарная запись: вызовы не пересекаются */
function save() {
  saveChain = saveChain.then(() => {
    try { saveSync(); } catch (err) { console.error('[store] ошибка записи:', err.message); }
  });
  return saveChain;
}

function get() {
  return load();
}

module.exports = { get, save, saveSync, withRequest, DATA_DIR, DB_FILE };

/* единый интерфейс с store-pg: запрос выполняется «как есть» */
async function withRequest(fn) {
  load();
  return fn();
}

module.exports.withRequest = withRequest;
